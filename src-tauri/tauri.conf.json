{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "stud",
  "version": "../package.json",
  "identifier": "app.stud.desktop",
  "mainBinaryName": "stud-desktop",
  "build": {
    "frontendDist": "../desktop/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "stud",
        "width": 820,
        "height": 730,
        "minWidth": 640,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/": ""
    },
    "externalBin": [
      "binaries/stud"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
